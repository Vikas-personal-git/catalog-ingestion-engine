# Catalog Ingestion Engine — environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# ── API keys (a tier is skipped when its provider has no key) ─────────────────
# At least one is required. Gemini: https://aistudio.google.com/apikey
#                           Claude: https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Model cost ladder ────────────────────────────────────────────────────────
# Every page starts on the first tier; it moves up only when deterministic verification
# (or the provider) fails it. Comma-separated "provider:model", cheapest first.
# Single-provider example: VLM_TIERS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash
VLM_TIERS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash,claude:claude-opus-5
# Gemini thinking level: minimal | low | medium | high
GEMINI_THINKING=low
# Claude effort (Opus / Sonnet 5): low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# Hard ceiling on AI spend per job in USD (0 = no cap). Remaining pages are reported as "needs re-run".
MAX_JOB_COST_USD=2
# Exchange rate used only to display costs in ₹ (all cost tracking is in USD)
USD_INR=96

# ── Pipeline ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_PAGES=6
# DPI of the page image sent to the vision model (crops always use the source's native resolution)
RENDER_DPI=150
# Records scoring below this are quarantined
PASS_THRESHOLD=0.95
# rembg model: u2net (fast, good default) | isnet-general-use | birefnet-general (slow, best edges)
REMBG_MODEL=u2net
# Product photos smaller than this (long edge, px) are upscaled (max 3×) with light sharpening…
MIN_IMAGE_PX=1000
# …and larger ones (high-resolution brand PDFs) are downscaled to this
MAX_IMAGE_PX=2000
# Tesseract OCR languages, "+"-joined (each needs its .traineddata installed), e.g. eng+hin
OCR_LANGS=eng
# Parallel OCR processes (lower it on machines with little RAM; default: up to 4)
OCR_WORKERS=4
# Accept products whose title OCR cannot read (logos/badges) when two different models agree on
# identical names and values — every number must still be verified against the page
NAME_CONSENSUS=true
OUTPUT_DIR=output
UPLOAD_DIR=uploads

# ── Server ────────────────────────────────────────────────────────────────────
# 127.0.0.1 = this machine only. The UI has no authentication; use 0.0.0.0 only on a trusted network.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Presentation mode: hides AI cost, model names and internal downloads (toggle per browser with ?view=demo)
DEMO_MODE=false
